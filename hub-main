local CeceHub = {}

function CeceHub:CreateCeceHub(ceceName)
    ceceName = ceceName or "CeceHub"

    local TweenService = game:GetService("TweenService")
    local UserInputService = game:GetService("UserInputService")

    local Theme = {
        Window = Color3.fromRGB(28, 30, 36),
        Window2 = Color3.fromRGB(22, 24, 30),

        Sidebar = Color3.fromRGB(32, 34, 42),
        Sidebar2 = Color3.fromRGB(26, 28, 36),

        Header = Color3.fromRGB(36, 38, 46),
        Header2 = Color3.fromRGB(30, 32, 40),

        Card = Color3.fromRGB(34, 36, 44),
        Card2 = Color3.fromRGB(28, 30, 38),

        Accent = Color3.fromRGB(120, 140, 180),
        Accent2 = Color3.fromRGB(100, 120, 160),
        AccentSoft = Color3.fromRGB(45, 50, 65),
        AccentHover = Color3.fromRGB(55, 62, 80),

        Stroke = Color3.fromRGB(70, 75, 90),
        Shadow = Color3.fromRGB(15, 16, 22),

        Text = Color3.fromRGB(230, 232, 240),
        TextSoft = Color3.fromRGB(140, 145, 160),
        White = Color3.fromRGB(255, 255, 255)
    }

    local function Corner(obj, radius)
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, radius or 12)
        c.Parent = obj
        return c
    end

    local function Stroke(obj, color, thickness, transparency)
        local s = Instance.new("UIStroke")
        s.Color = color or Theme.Stroke
        s.Thickness = thickness or 1.2
        s.Transparency = transparency or 0
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Parent = obj
        return s
    end

    local function Gradient(obj, c1, c2, rotation)
        local g = Instance.new("UIGradient")
        g.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, c1),
            ColorSequenceKeypoint.new(1, c2)
        })
        g.Rotation = rotation or 90
        g.Parent = obj
        return g
    end

    local function HoverTween(button, enterColor, leaveColor, textEnter, textLeave)
        button.MouseEnter:Connect(function()
            TweenService:Create(button, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundColor3 = enterColor
            }):Play()

            if textEnter then
                TweenService:Create(button, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    TextColor3 = textEnter
                }):Play()
            end
        end)

        button.MouseLeave:Connect(function()
            TweenService:Create(button, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundColor3 = leaveColor
            }):Play()

            if textLeave then
                TweenService:Create(button, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    TextColor3 = textLeave
                }):Play()
            end
        end)
    end

    local function PressTween(button, originalSize)
        local pressedSize = UDim2.new(
            originalSize.X.Scale, originalSize.X.Offset - 2,
            originalSize.Y.Scale, originalSize.Y.Offset - 2
        )

        button.MouseButton1Down:Connect(function()
            TweenService:Create(button, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = pressedSize
            }):Play()
        end)

        button.MouseButton1Up:Connect(function()
            TweenService:Create(button, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = originalSize
            }):Play()
        end)

        button.MouseLeave:Connect(function()
            TweenService:Create(button, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = originalSize
            }):Play()
        end)
    end

    local function MakeCard(parent, name, sizeY)
        local f = Instance.new("Frame")
        f.Name = name
        f.Parent = parent
        f.BackgroundColor3 = Theme.Card
        f.BorderSizePixel = 0
        f.Size = UDim2.new(1, -16, 0, sizeY or 50)
        Corner(f, 12)
        Stroke(f, Theme.Stroke, 1.4, 0.1)
        Gradient(f, Theme.Card, Theme.Card2, 90)
        return f
    end

    if game.CoreGui:FindFirstChild("CeceHubModernUI") then
        game.CoreGui:FindFirstChild("CeceHubModernUI"):Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "CeceHubModernUI"
    ScreenGui.Parent = game.CoreGui
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.ResetOnSpawn = false

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Parent = ScreenGui
    MainFrame.BackgroundColor3 = Theme.Window
