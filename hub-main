    libTitle.TextXAlignment = Enum.TextXAlignment.Left

    local closeLib = Instance.new("ImageButton")
    closeLib.Name = "closeLib"
    closeLib.Parent = header
    closeLib.BackgroundTransparency = 1
    closeLib.Position = UDim2.new(1, -42, 0.5, -13)
    closeLib.Size = UDim2.new(0, 26, 0, 26)
    closeLib.Image = "rbxassetid://4988112250"
    closeLib.ImageColor3 = Theme.Accent2

    local elementContainer = Instance.new("Frame")
    elementContainer.Name = "elementContainer"
    elementContainer.Parent = MainFrame_2
    elementContainer.BackgroundColor3 = Theme.Card
    elementContainer.BorderSizePixel = 0
    elementContainer.Position = UDim2.new(0, 184, 0, 78)
    elementContainer.Size = UDim2.new(1, -198, 1, -92)
    elementContainer.ClipsDescendants = true
    Corner(elementContainer, 16)
    Stroke(elementContainer, Theme.Stroke, 1.4, 0.08)
    Gradient(elementContainer, Theme.Card, Theme.Card2, 90)

    local pagesFolder = Instance.new("Folder")
    pagesFolder.Parent = elementContainer

    local defaultWindowSize = UDim2.new(0, 640, 0, 390)
    local compactWindowSize = UDim2.new(0, 640, 0, 82)

    local isClosed = false
    local firstTabButton = nil

    local function collapseWindow()
        isClosed = true
        closeLib.Image = "rbxassetid://5165666242"

        tabFrame.Visible = false
        elementContainer.Visible = false

        TweenService:Create(closeLib, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Rotation = 180
        }):Play()

        TweenService:Create(header, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 14, 0, 14),
            Size = UDim2.new(1, -28, 0, 54)
        }):Play()

        MainFrame:TweenSize(compactWindowSize, "Out", "Quint", 0.22, true)
    end

    local function expandWindow()
        isClosed = false
        closeLib.Image = "rbxassetid://4988112250"

        TweenService:Create(closeLib, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Rotation = 0
        }):Play()

        MainFrame:TweenSize(defaultWindowSize, "Out", "Quint", 0.22, true)

        TweenService:Create(header, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 184, 0, 14),
            Size = UDim2.new(1, -198, 0, 54)
        }):Play()

        task.delay(0.08, function()
            tabFrame.Visible = true
            elementContainer.Visible = true
        end)
    end

    closeLib.MouseButton1Click:Connect(function()
        if isClosed then
            expandWindow()
        else
            collapseWindow()
        end
    end)

    do
        local dragging = false
        local dragStart
        local frameStart

        header.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                frameStart = MainFrame.AbsolutePosition
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                MainFrame.Position = UDim2.fromOffset(frameStart.X + delta.X, frameStart.Y + delta.Y)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end

    local SectionHandler = {}

    function SectionHandler:CreateSection(secName)
        secName = secName or "Tab"

        local tabBtn = Instance.new("TextButton")
        tabBtn.Name = "tabBtn_" .. secName
        tabBtn.Parent = tabFrame
        tabBtn.BackgroundColor3 = Theme.White
        tabBtn.BorderSizePixel = 0
        tabBtn.Size = UDim2.new(1, 0, 0, 39)
        tabBtn.Font = Enum.Font.GothamSemibold
        tabBtn.Text = secName
        tabBtn.TextColor3 = Theme.TextSoft
        tabBtn.TextSize = 14
        tabBtn.AutoButtonColor = false
        Corner(tabBtn, 11)
        Stroke(tabBtn, Theme.Stroke, 1.3, 0.2)
        Gradient(tabBtn, Color3.fromRGB(42, 44, 54), Color3.fromRGB(32, 34, 42), 0)
        HoverTween(tabBtn, Theme.AccentHover, Color3.fromRGB(42, 44, 54), Theme.Text, Theme.TextSoft)

        local newPage = Instance.new("ScrollingFrame")
        newPage.Name = "newPage_" .. secName
        newPage.Parent = pagesFolder
        newPage.Active = true
        newPage.BackgroundTransparency = 1
        newPage.BorderSizePixel = 0
        newPage.Size = UDim2.new(1, 0, 1, 0)
        newPage.ScrollBarThickness = 4
        newPage.ScrollBarImageColor3 = Theme.Accent
        newPage.Visible = false
        newPage.CanvasSize = UDim2.new(0, 0, 0, 0)

        local pageItemList = Instance.new("UIListLayout")
        pageItemList.Parent = newPage
        pageItemList.HorizontalAlignment = Enum.HorizontalAlignment.Center
        pageItemList.SortOrder = Enum.SortOrder.LayoutOrder
        pageItemList.Padding = UDim.new(0, 8)

        local UIPadding = Instance.new("UIPadding")
        UIPadding.Parent = newPage
        UIPadding.PaddingTop = UDim.new(0, 10)
        UIPadding.PaddingBottom = UDim.new(0, 10)

        local function UpdateSize()
            local cS = pageItemList.AbsoluteContentSize
            newPage.CanvasSize = UDim2.new(0, 0, 0, cS.Y + 18)
        end

        pageItemList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateSize)
        UpdateSize()

        local function OpenThisPage()
            for _, page in ipairs(pagesFolder:GetChildren()) do
                if page:IsA("ScrollingFrame") then
                    page.Visible = false
                end
            end

            for _, v in ipairs(tabFrame:GetChildren()) do
                if v:IsA("TextButton") then
                    TweenService:Create(v, TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                        BackgroundColor3 = Color3.fromRGB(42, 44, 54),
                        TextColor3 = Theme.TextSoft
                    }):Play()
                end
            end

            newPage.Visible = true

            TweenService:Create(tabBtn, TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                BackgroundColor3 = Theme.AccentSoft,
                TextColor3 = Theme.Text
            }):Play()

            UpdateSize()
        end

        tabBtn.MouseButton1Click:Connect(OpenThisPage)

        if not firstTabButton then
            firstTabButton = tabBtn
            task.defer(OpenThisPage)
        end

        local ElementHandler = {}

        function ElementHandler:TextLabel(labelText)
            labelText = labelText or ""

            local labelFrame = MakeCard(newPage, "labelFrame", 46)

            local txtLabel = Instance.new("TextLabel")
            txtLabel.Parent = labelFrame
            txtLabel.BackgroundTransparency = 1
            txtLabel.Position = UDim2.new(0, 14, 0, 0)
            txtLabel.Size = UDim2.new(1, -28, 1, 0)
            txtLabel.Font = Enum.Font.GothamSemibold
            txtLabel.Text = labelText
            txtLabel.TextColor3 = Theme.Text
            txtLabel.TextSize = 14
            txtLabel.TextXAlignment = Enum.TextXAlignment.Left
        end

        function ElementHandler:TextButton(buttonText, buttonInfo, callback)
            buttonText = buttonText or ""
            buttonInfo = buttonInfo or ""
            callback = callback or function() end

            local textButtonFrame = MakeCard(newPage, "textButtonFrame", 54)

            local Button = Instance.new("TextButton")
            Button.Parent = textButtonFrame
            Button.BackgroundColor3 = Theme.AccentSoft
            Button.Position = UDim2.new(0, 12, 0.5, -15)
            Button.Size = UDim2.new(0, 154, 0, 30)
            Button.BorderSizePixel = 0
            Button.Font = Enum.Font.GothamSemibold
            Button.Text = buttonText
            Button.TextColor3 = Theme.Text
            Button.TextSize = 14
            Button.AutoButtonColor = false
            Corner(Button, 10)
            Stroke(Button, Theme.Stroke, 1.3, 0.15)
            Gradient(Button, Color3.fromRGB(50, 55, 70), Color3.fromRGB(38, 42, 55), 0)
            HoverTween(Button, Theme.AccentHover, Theme.AccentSoft, Theme.Text, Theme.Text)
            PressTween(Button, UDim2.new(0, 154, 0, 30))

            local Info = Instance.new("TextLabel")
            Info.Parent = textButtonFrame
            Info.BackgroundTransparency = 1
            Info.Position = UDim2.new(0, 176, 0, 0)
            Info.Size = UDim2.new(1, -188, 1, 0)
            Info.Font = Enum.Font.GothamSemibold
            Info.Text = buttonInfo
            Info.TextColor3 = Theme.TextSoft
            Info.TextSize = 13
            Info.TextXAlignment = Enum.TextXAlignment.Right

            Button.MouseButton1Click:Connect(callback)
        end

        function ElementHandler:Toggle(togInfo, callback)
            togInfo = togInfo or ""
            callback = callback or function() end

            local toggleFrame = MakeCard(newPage, "toggleFrame", 54)

            local toggleInfo = Instance.new("TextLabel")
            toggleInfo.Parent = toggleFrame
            toggleInfo.BackgroundTransparency = 1
            toggleInfo.Position = UDim2.new(0, 70, 0, 0)
            toggleInfo.Size = UDim2.new(1, -84, 1, 0)
            toggleInfo.Font = Enum.Font.GothamSemibold
            toggleInfo.Text = togInfo
            toggleInfo.TextColor3 = Theme.Text
            toggleInfo.TextSize = 14
            toggleInfo.TextXAlignment = Enum.TextXAlignment.Left

            local holder = Instance.new("Frame")
            holder.Parent = toggleFrame
            holder.BackgroundColor3 = Color3.fromRGB(55, 58, 68)
            holder.BorderSizePixel = 0
            holder.Position = UDim2.new(0, 12, 0.5, -11)
            holder.Size = UDim2.new(0, 44, 0, 22)
            Corner(holder, 999)
            local holderStroke = Stroke(holder, Theme.Stroke, 1.3, 0.2)

            local knob = Instance.new("TextButton")
            knob.Parent = holder
            knob.BackgroundColor3 = Theme.White
            knob.BorderSizePixel = 0
            knob.Position = UDim2.new(0, 2, 0, 2)
            knob.Size = UDim2.new(0, 18, 0, 18)
            knob.Text = ""
            knob.AutoButtonColor = false
            Corner(knob, 999)
            Stroke(knob, Theme.Stroke, 1.2, 0.25)

            local toggled = false

            local function setToggle(state)
                toggled = state
                callback(toggled)

                if toggled then
                    TweenService:Create(holder, TweenInfo.new(0.18), {
                        BackgroundColor3 = Theme.Accent
                    }):Play()

                    TweenService:Create(knob, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Position = UDim2.new(0, 24, 0, 2)
                    }):Play()

                    TweenService:Create(holderStroke, TweenInfo.new(0.18), {
                        Color = Theme.Accent2,
                        Transparency = 0.05
                    }):Play()
                else
                    TweenService:Create(holder, TweenInfo.new(0.18), {
                        BackgroundColor3 = Color3.fromRGB(55, 58, 68)
                    }):Play()

                    TweenService:Create(knob, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Position = UDim2.new(0, 2, 0, 2)
                    }):Play()

                    TweenService:Create(holderStroke, TweenInfo.new(0.18), {
                        Color = Theme.Stroke,
                        Transparency = 0.2
                    }):Play()
                end
            end

            holder.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    setToggle(not toggled)
                end
            end)

            knob.MouseButton1Click:Connect(function()
                setToggle(not toggled)
            end)
        end

        function ElementHandler:Slider(sliderin, minvalue, maxvalue, callback)
            sliderin = sliderin or "Slider"
            minvalue = minvalue or 0
            maxvalue = maxvalue or 100
            callback = callback or function() end

            local sliderFrame = MakeCard(newPage, "sliderFrame", 66)

            local sliderInfo = Instance.new("TextLabel")
            sliderInfo.Parent = sliderFrame
            sliderInfo.BackgroundTransparency = 1
            sliderInfo.Position = UDim2.new(0, 12, 0, 8)
            sliderInfo.Size = UDim2.new(1, -24, 0, 18)
            sliderInfo.Font = Enum.Font.GothamSemibold
            sliderInfo.Text = sliderin
            sliderInfo.TextColor3 = Theme.Text
            sliderInfo.TextSize = 14
            sliderInfo.TextXAlignment = Enum.TextXAlignment.Left

            local sliderValue = Instance.new("TextLabel")
            sliderValue.Parent = sliderFrame
            sliderValue.BackgroundTransparency = 1
            sliderValue.Position = UDim2.new(1, -90, 0, 8)
            sliderValue.Size = UDim2.new(0, 78, 0, 18)
            sliderValue.Font = Enum.Font.GothamSemibold
            sliderValue.Text = tostring(minvalue) .. "/" .. tostring(maxvalue)
            sliderValue.TextColor3 = Theme.Accent2
            sliderValue.TextSize = 13
            sliderValue.TextXAlignment = Enum.TextXAlignment.Right

            local sliderBtn = Instance.new("Frame")
            sliderBtn.Parent = sliderFrame
            sliderBtn.BackgroundColor3 = Color3.fromRGB(50, 53, 62)
            sliderBtn.BorderSizePixel = 0
            sliderBtn.Position = UDim2.new(0, 12, 0, 40)
            sliderBtn.Size = UDim2.new(1, -24, 0, 10)
            Corner(sliderBtn, 999)

            local fill = Instance.new("Frame")
            fill.Parent = sliderBtn
            fill.BackgroundColor3 = Theme.Accent
            fill.Size = UDim2.new(0, 0, 1, 0)
            fill.BorderSizePixel = 0
            Corner(fill, 999)
            Gradient(fill, Theme.Accent, Theme.Accent2, 0)

            local knob = Instance.new("Frame")
            knob.Parent = sliderBtn
            knob.BackgroundColor3 = Theme.White
            knob.Size = UDim2.new(0, 14, 0, 14)
            knob.AnchorPoint = Vector2.new(0.5, 0.5)
            knob.Position = UDim2.new(0, 0, 0.5, 0)
            Corner(knob, 999)
            Stroke(knob, Theme.Stroke, 1.3, 0.15)

            local dragging = false
            local currentValue = minvalue

            local function update(x)
                local size = sliderBtn.AbsoluteSize.X
                local pos = math.clamp(x - sliderBtn.AbsolutePosition.X, 0, size)

                local percent = 0
                if size > 0 then
                    percent = pos / size
                end

                currentValue = math.floor(minvalue + (maxvalue - minvalue) * percent)

                sliderValue.Text = currentValue .. "/" .. maxvalue
                callback(currentValue)

                TweenService:Create(fill, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Size = UDim2.new(percent, 0, 1, 0)
                }):Play()

                TweenService:Create(knob, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Position = UDim2.new(percent, 0, 0.5, 0)
                }):Play()
            end

            sliderBtn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    update(input.Position.X)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    update(input.Position.X)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                end
            end)
        end

        function ElementHandler:KeyBind(keInfo, firstt, callback)
            keInfo = keInfo or ""
            callback = callback or function() end

            local oldKey = "E"
            if typeof(firstt) == "EnumItem" and firstt.EnumType == Enum.KeyCode then
                oldKey = firstt.Name
            end

            local keybindFrame = MakeCard(newPage, "keybindFrame", 54)

            local keyButton = Instance.new("TextButton")
            keyButton.Parent = keybindFrame
            keyButton.BackgroundColor3 = Theme.AccentSoft
            keyButton.BorderSizePixel = 0
            keyButton.Position = UDim2.new(0, 12, 0.5, -15)
            keyButton.Size = UDim2.new(0, 86, 0, 30)
            keyButton.Font = Enum.Font.GothamSemibold
            keyButton.Text = oldKey
            keyButton.TextColor3 = Theme.Text
            keyButton.TextSize = 14
            keyButton.AutoButtonColor = false
            Corner(keyButton, 10)
            Stroke(keyButton, Theme.Stroke, 1.3, 0.15)
            HoverTween(keyButton, Theme.AccentHover, Theme.AccentSoft, Theme.Text, Theme.Text)
            PressTween(keyButton, UDim2.new(0, 86, 0, 30))

            local keybindinfo = Instance.new("TextLabel")
            keybindinfo.Parent = keybindFrame
            keybindinfo.BackgroundTransparency = 1
            keybindinfo.Position = UDim2.new(0, 110, 0, 0)
            keybindinfo.Size = UDim2.new(1, -122, 1, 0)
            keybindinfo.Font = Enum.Font.GothamSemibold
            keybindinfo.Text = keInfo
            keybindinfo.TextColor3 = Theme.TextSoft
            keybindinfo.TextSize = 13
            keybindinfo.TextXAlignment = Enum.TextXAlignment.Right

            local waitingForBind = false

            keyButton.MouseButton1Click:Connect(function()
                waitingForBind = true
                keyButton.Text = "..."
            end)

            UserInputService.InputBegan:Connect(function(input, gp)
                if gp then return end

                if waitingForBind then
                    if input.KeyCode ~= Enum.KeyCode.Unknown then
                        oldKey = input.KeyCode.Name
                        keyButton.Text = oldKey
                        waitingForBind = false
                    end
                    return
                end

                if input.KeyCode.Name == oldKey then
                    callback()
                end
            end)
        end

        function ElementHandler:TextBox(textInfo, placeHolderText1, callback)
            textInfo = textInfo or ""
            placeHolderText1 = placeHolderText1 or ""
            callback = callback or function() end

            local textBoxFrame = MakeCard(newPage, "textBoxFrame", 54)

            local textboxInfo = Instance.new("TextLabel")
            textboxInfo.Parent = textBoxFrame
            textboxInfo.BackgroundTransparency = 1
            textboxInfo.Position = UDim2.new(0, 12, 0, 0)
            textboxInfo.Size = UDim2.new(0, 128, 1, 0)
            textboxInfo.Font = Enum.Font.GothamSemibold
            textboxInfo.Text = textInfo
            textboxInfo.TextColor3 = Theme.Text
            textboxInfo.TextSize = 14
            textboxInfo.TextXAlignment = Enum.TextXAlignment.Left

            local inputHolder = Instance.new("Frame")
            inputHolder.Parent = textBoxFrame
            inputHolder.BackgroundColor3 = Color3.fromRGB(42, 44, 54)
            inputHolder.BorderSizePixel = 0
            inputHolder.Position = UDim2.new(1, -174, 0.5, -15)
            inputHolder.Size = UDim2.new(0, 160, 0, 30)
            Corner(inputHolder, 10)
            Stroke(inputHolder, Theme.Stroke, 1.3, 0.15)

            local TextBox = Instance.new("TextBox")
            TextBox.Parent = inputHolder
            TextBox.BackgroundTransparency = 1
            TextBox.Position = UDim2.new(0, 8, 0, 0)
            TextBox.Size = UDim2.new(1, -16, 1, 0)
            TextBox.Font = Enum.Font.GothamSemibold
            TextBox.PlaceholderColor3 = Theme.TextSoft
            TextBox.PlaceholderText = placeHolderText1
            TextBox.Text = ""
            TextBox.TextColor3 = Theme.Text
            TextBox.TextSize = 13
            TextBox.TextXAlignment = Enum.TextXAlignment.Left
            TextBox.ClearTextOnFocus = false

            TextBox.Focused:Connect(function()
                TweenService:Create(inputHolder, TweenInfo.new(0.14), {
                    BackgroundColor3 = Color3.fromRGB(50, 52, 64)
                }):Play()
            end)

            TextBox.FocusLost:Connect(function(enterPressed)
                TweenService:Create(inputHolder, TweenInfo.new(0.14), {
                    BackgroundColor3 = Color3.fromRGB(42, 44, 54)
                }):Play()

                if not enterPressed then return end
                callback(TextBox.Text)
                TextBox.Text = ""
            end)
        end

        function ElementHandler:Dropdown(dInfo, list, callback)
            dInfo = dInfo or ""
            list = list or {}
            callback = callback or function() end

            local isDropped = false
            local baseSize = 52

            local dropDownFrame = MakeCard(newPage, "dropDownFrame", baseSize)
            dropDownFrame.ClipsDescendants = true

            local dropdownmain = Instance.new("Frame")
            dropdownmain.Parent = dropDownFrame
            dropdownmain.BackgroundTransparency = 1
            dropdownmain.Size = UDim2.new(1, 0, 0, baseSize)

            local dropdownItem = Instance.new("TextLabel")
            dropdownItem.Parent = dropdownmain
            dropdownItem.BackgroundTransparency = 1
            dropdownItem.Position = UDim2.new(0, 14, 0, 0)
            dropdownItem.Size = UDim2.new(1, -50, 0, baseSize)
            dropdownItem.Font = Enum.Font.GothamSemibold
            dropdownItem.Text = dInfo
            dropdownItem.TextColor3 = Theme.Text
            dropdownItem.TextSize = 14
            dropdownItem.TextXAlignment = Enum.TextXAlignment.Left

            local ImageButton = Instance.new("ImageButton")
            ImageButton.Parent = dropdownmain
            ImageButton.BackgroundTransparency = 1
            ImageButton.Position = UDim2.new(1, -36, 0.5, -10)
            ImageButton.Size = UDim2.new(0, 20, 0, 20)
            ImageButton.Image = "rbxassetid://5165666242"
            ImageButton.ImageColor3 = Theme.Accent2

            local listLayout = Instance.new("UIListLayout")
            listLayout.Parent = dropDownFrame
            listLayout.Padding = UDim.new(0, 6)
            listLayout.SortOrder = Enum.SortOrder.LayoutOrder
            listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

            local totalSize = baseSize

            for _, v in ipairs(list) do
                local optionBtn = Instance.new("TextButton")
                optionBtn.Parent = dropDownFrame
                optionBtn.BackgroundColor3 = Theme.AccentSoft
                optionBtn.BorderSizePixel = 0
                optionBtn.Size = UDim2.new(1, -18, 0, 36)
                optionBtn.Font = Enum.Font.GothamSemibold
                optionBtn.Text = " " .. tostring(v)
                optionBtn.TextColor3 = Theme.Text
                optionBtn.TextSize = 13
                optionBtn.TextXAlignment = Enum.TextXAlignment.Left
                optionBtn.AutoButtonColor = false
                Corner(optionBtn, 10)
                Stroke(optionBtn, Theme.Stroke, 1.2, 0.15)
                HoverTween(optionBtn, Theme.AccentHover, Theme.AccentSoft, Theme.Text, Theme.Text)

                totalSize = totalSize + 42

                optionBtn.MouseButton1Click:Connect(function()
                    dropdownItem.Text = dInfo .. ": " .. tostring(v)
                    callback(v)

                    isDropped = false
                    dropDownFrame:TweenSize(UDim2.new(1, -16, 0, baseSize), "Out", "Quint", 0.16, true)
                    TweenService:Create(ImageButton, TweenInfo.new(0.16), {
                        Rotation = 0
                    }):Play()

                    task.delay(0.17, UpdateSize)
                end)
            end

            ImageButton.MouseButton1Click:Connect(function()
                isDropped = not isDropped

                if isDropped then
                    dropDownFrame:TweenSize(UDim2.new(1, -16, 0, totalSize), "Out", "Quint", 0.16, true)
                    TweenService:Create(ImageButton, TweenInfo.new(0.16), {
                        Rotation = 180
                    }):Play()
                else
                    dropDownFrame:TweenSize(UDim2.new(1, -16, 0, baseSize), "Out", "Quint", 0.16, true)
                    TweenService:Create(ImageButton, TweenInfo.new(0.16), {
                        Rotation = 0
                    }):Play()
                end

                task.delay(0.17, UpdateSize)
            end)
        end

        return ElementHandler
    end

    return SectionHandler
end

return CeceHub
